# 이 파일을 .env로 복사한 뒤 필요한 값을 채우세요
#   cp .env.example .env
#
# 로컬 개발에서는 비워두는 편이 낫습니다.
# 비어 있으면 vite.config.ts의 proxy(/api → http://localhost:8000)를 그대로 씁니다.
#
# 배포(Vercel)에서는 반드시 백엔드 주소를 넣어야 합니다.
# 프론트가 HTTPS로 서비스되므로 백엔드도 HTTPS여야 브라우저가 차단하지 않습니다.
# 예) VITE_API_BASE_URL=https://hearsay-api.example.com

VITE_API_BASE_URL=
